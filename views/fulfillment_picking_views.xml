<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_inherit_fulfillment" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.fulfillment</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='location_dest_id']" position="after">
                <field name="picking_type_id_name" invisible="1"/>
                <field name="marketplace_location" 
                    invisible="picking_type_id_name != 'Resurtido a Ful: Pick'"
                    required="picking_type_id_name == 'Resurtido a Ful: Pick'"/>
            </xpath>
        </field>
    </record>
</odoo>
