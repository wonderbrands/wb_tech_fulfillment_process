<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_inherit_fulfillment" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.fulfillment</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='location_dest_id']" position="after">
                <field name="picking_type_ful_role" invisible="1"/>
                <field name="marketplace_location"
                    invisible="picking_type_ful_role != 'pick'"
                    required="picking_type_ful_role == 'pick'"/>
            </xpath>
        </field>
    </record>

    <record id="view_picking_search_inherit_fulfillment" model="ir.ui.view">
        <field name="name">stock.picking.search.inherit.fulfillment</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_internal_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='starred']" position="after">
                <separator/>
                <filter name="ful_pick" string="Fulfillment: Pick"
                        domain="[('picking_type_ful_role', '=', 'pick')]"/>
                <filter name="ful_dispatch" string="Fulfillment: Despacho"
                        domain="[('picking_type_ful_role', '=', 'dispatch')]"/>
            </xpath>
        </field>
    </record>

    <record id="view_picking_type_form_inherit_fulfillment" model="ir.ui.view">
        <field name="name">stock.picking.type.form.inherit.fulfillment</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.view_picking_type_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='create_backorder']" position="after">
                <field name="ful_role"/>
                <field name="no_merge_destination"/>
            </xpath>
        </field>
    </record>
</odoo>
